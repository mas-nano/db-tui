connections:
  - name: local-sqlite
    driver: sqlite
    file_path: ./dev.db
  - name: local-postgres
    driver: postgres
    host: localhost
    port: 5432
    user: postgres
    password: postgres
    database: postgres
  - name: local-mariadb
    driver: mysql
    host: 127.0.0.1
    port: 3306
    user: root
    password: root
    database: test
